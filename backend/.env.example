# ============================================================
# Autonomous Learning Agent - Backend Configuration
# ============================================================
# Copy this file to backend/.env and fill in the values you need.
# Defaults work for local development WITHOUT Docker.
# ============================================================

# --- DATABASE ---
# SQLite (default - zero setup, no Docker needed):
DATABASE_URL=sqlite+aiosqlite:///./storage/agent.db
# PostgreSQL (for Docker deployment):
# DATABASE_URL=postgresql+asyncpg://agent:agent_password@localhost:5432/learning_agent

# --- REDIS ---
# Leave empty for in-process mode (no Docker needed):
REDIS_URL=
# Redis server (for Docker deployment):
# REDIS_URL=redis://localhost:6379/0

# --- QDRANT ---
# Local persistent mode (no Docker needed, survives restarts):
QDRANT_URL=./storage/qdrant
# Ephemeral in-memory mode (data lost on restart):
# QDRANT_URL=:memory:
# Qdrant server (Docker deployment, persistent storage):
# QDRANT_URL=http://localhost:6333
# Qdrant Cloud (required when hosted on Render):
# QDRANT_URL=https://xxxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=agent_learnings

# --- OLLAMA (local models; optional when a cloud provider is configured) ---
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_TEMPERATURE=0.7

# --- EMBEDDINGS ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- AUTH ---
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- AGENT DEFAULTS ---
DEFAULT_MAX_ITERATIONS=100
DEFAULT_SNAPSHOT_INTERVAL=50
DEFAULT_SYNTHESIS_INTERVAL=100
DEFAULT_TOP_K=5
DEFAULT_MIN_SIMILARITY=0.65
DEFAULT_USE_PERSISTENT_LEARNING=false

# --- STORAGE ---
STORAGE_DIR=./storage

# --- TOOL PERMISSIONS ---
TOOL_PERMISSION_PYTHON=LIMITED
TOOL_PERMISSION_SHELL=READ_ONLY
TOOL_PERMISSION_HTTP=LIMITED
TOOL_PERMISSION_FILE=READ_ONLY

# --- SANDBOX ---
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=512

# --- SERVER ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- CLOUD LLM PROVIDERS ---
# Provider options: ollama | groq | gemini | openai | openrouter
LLM_PROVIDER=ollama
# Model ids used when a cloud provider is selected.
# Examples:
#   Groq:   CLOUD_MODEL=openai/gpt-oss-120b   (or openai/gpt-oss-20b)
#   Gemini: CLOUD_MODEL=gemini/gemini-2.0-flash
#   OpenAI: CLOUD_MODEL=openai/gpt-4o-mini
CLOUD_MODEL=
PRIMARY_MODEL=qwen3:4b
FAST_MODEL=qwen3:4b
SYNTHESIS_MODEL=qwen3:4b

# Insert your own API keys below (at least one is required for a cloud provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
