# ============================================================
# Minesweeper Learning Lab - backend configuration
# Copy to backend/.env (local runs) or ./.env (docker-compose).
# ============================================================

# --- DATABASE ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./storage/agent.db
# PostgreSQL (docker-compose / Render). postgres:// and postgresql:// URLs are accepted as-is.
# DATABASE_URL=postgresql+asyncpg://agent:agent_password@localhost:5432/learning_agent

# --- AGENTS ---
# Experiments use code-only learning agents: no LLM, no API key, no rate limits.
# The LLM agents are kept but disabled; set to true to offer them again (then configure the LLM section).
ENABLE_LLM_AGENTS=false
# Pause between move rounds in "watch" speed (milliseconds).
WATCH_MOVE_DELAY_MS=350

# --- LLM (optional; only used when ENABLE_LLM_AGENTS=true) ---
# Provider used for model names without a "<provider>:" prefix:
#   ollama | groq | openai | gemini | openrouter | custom
LLM_PROVIDER=ollama
# Default model for new experiments (each experiment can pick its own).
#   Ollama example:  qwen3:4b
#   Groq example:    openai/gpt-oss-20b   (with LLM_PROVIDER=groq)
#   Prefixed form:   groq:openai/gpt-oss-120b, ollama:llama3.1:8b
PRIMARY_MODEL=qwen3:4b
DEFAULT_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=90
# Optional, for reasoning models such as gpt-oss: low | medium | high (empty = provider default)
LLM_REASONING_EFFORT=

OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# For LLM_PROVIDER=custom (any OpenAI-compatible server), or to override a provider's URL/key:
CLOUD_BASE_URL=
CLOUD_API_KEY=

# --- AUTH ---
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_EXPIRATION_MINUTES=1440

# --- EXPERIMENTS ---
DEFAULT_NUM_GAMES=500
MAX_NUM_GAMES=5000
# Lessons shown to the memory agent in every move prompt.
PLAYBOOK_PROMPT_LIMIT=12
# Active lessons kept per user; the weakest are retired beyond this.
PLAYBOOK_MAX_ACTIVE=40
# Pause between moves (seconds), useful to stay under a provider's requests-per-minute limit.
MOVE_DELAY_SECONDS=0
MAX_CONSECUTIVE_LLM_ERRORS=5
# Moves the agent may play from ONE LLM call when it is certain of them. Each still counts as a move;
# higher values mean far fewer (rate-limited) LLM calls. 1 = one call per move.
MAX_MOVES_PER_TURN=8

# --- SERVER ---
# Comma-separated browser origins allowed to call the API, or * (auth uses bearer tokens, not cookies).
CORS_ORIGINS=*
